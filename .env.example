# Public client env for local development (copy to `.env` and `apps/mobile/.env`).
# Never commit real `.env` files. Never put service-role keys or GEMINI_API_KEY here.

# Supabase project URL (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase publishable / anon public key (safe in the client; RLS protects rows)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Optional HTTPS MapLibre style URL. Leave empty for GPS route outline only.
EXPO_PUBLIC_MAP_TILE_STYLE_URL=
